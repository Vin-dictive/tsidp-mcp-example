PORT=9933
DATABASE_URL=postgres://<user>:<password>@<host>:<port>/<database>
# Issuer of the tsidp node. Overwritten if local-tailscaled mode picks another URL.
TSIDP_URL=https://<idp-host>
# Must match the URL Aperture uses, and the resources entry in the tailnet grant.
RESOURCE_URL=https://<mcp-host>/mcp
# One shared bearer for the Aperture shopshared connector. Not a Tailscale user.
# Copy to .env and replace this value.
SHARED_TOKEN=replace-with-a-random-token
