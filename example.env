# Copy to .env and replace every value. .env is not committed.

# The catalog is a SQLite file, created and seeded on first open. The Compose
# shop service sets its own path (/data/shop.db on a named volume); this one is
# for host development (`npm start` in server/).
PORT=9933
DATABASE_PATH=./data/shop.db

# Node names on your tailnet. Each becomes <hostname>.<tailnet>.ts.net.
TSIDP_HOSTNAME=idp
SHOP_HOSTNAME=shop-mcp

# tsidp issuer, built from TSIDP_HOSTNAME.
TSIDP_URL=https://idp.<tailnet>.ts.net

# This string has to match the resources entry in the tailnet grant exactly.
SHOP_RESOURCE_URL=https://shop-mcp.<tailnet>.ts.net/mcp

# Tags for the two nodes. Both must exist in tagOwners in the tailnet policy
# before first start, or registration fails.
TSIDP_TAG=tag:tsidp
MCP_TAG=tag:mcpserver

# One OAuth client secret tags both nodes, because each node asks for its own
# tag. Create it at https://login.tailscale.com/admin/settings/oauth with the
# auth_keys write scope and both tags above, then append ?ephemeral=false so
# the nodes persist:
#   TS_AUTHKEY=tskey-client-xxxxxxxxxxxx?ephemeral=false
#
# A plain tskey-auth- key cannot do this: the tags on a key are authoritative,
# so one key holding both tags puts both tags on both nodes. Use two keys
# instead if you prefer -- set TS_AUTHKEY for tsidp and TS_AUTHKEY_SHOP for
# ts-shop, and swap the ts-shop TS_AUTHKEY in docker-compose.yml to match.
TS_AUTHKEY=
