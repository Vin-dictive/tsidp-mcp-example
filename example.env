# Copy to .env and replace every value. .env is not committed.
# Passwords must not contain @, :, /, or a space. They go into a Postgres URL.

POSTGRES_USER=shop
POSTGRES_PASSWORD=replace-with-a-password
POSTGRES_DB=shop
MCP_READER_PASSWORD=replace-with-another-password

# Host development (`npm start` in server/). The Compose shop service does not use this.
PORT=9933
DATABASE_URL=postgres://mcp_reader:replace-with-another-password@127.0.0.1:54329/shop
TAILNET_BIND=
TAILNET_PORT=9935

# tsidp node. Hostname idp comes from docker-compose.yml.
TSIDP_URL=https://idp.<tailnet>.ts.net

# The shop container's own tailnet name. Hostname shop-mcp comes from SHOP_HOSTNAME.
# This string has to match the resources entry in the tailnet grant exactly.
SHOP_HOSTNAME=shop-mcp
SHOP_RESOURCE_URL=https://shop-mcp.<tailnet>.ts.net/mcp

# One shared bearer for the Aperture shopshared connector. Generate with: openssl rand -hex 24
SHARED_TOKEN=replace-with-a-random-token

# Auth key from https://login.tailscale.com/admin/settings/keys
# Leave empty to approve the login URL printed by `docker compose logs ts-shop`.
TS_AUTHKEY=
