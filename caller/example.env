PORT=9945
# This Mac's Tailscale address. Aperture connects here directly.
# Do not publish this port with tailscale serve.
BIND=100.x.y.z
DATABASE_URL=postgres://<user>:<password>@<host>:<port>/<database>
# Static bearer Aperture sends as Authorization. Copy to .env and replace this value.
CALLER_TOKEN=replace-with-a-random-token
